# Where Terraform keeps state for production. Replace the bucket with your state bucket in account 673786334990.
bucket       = "REPLACE_WITH_STATE_BUCKET"
key          = "perkins/datadog-log-forwarding/prod.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # S3-native state locking (Terraform 1.10+). Use dynamodb_table instead on older versions.
