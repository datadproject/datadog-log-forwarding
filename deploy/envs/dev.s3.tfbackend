# Where Terraform keeps state for development. Replace the bucket with your state bucket in account 199570264848.
bucket       = "REPLACE_WITH_STATE_BUCKET"
key          = "perkins/datadog-log-forwarding/dev.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # S3-native state locking (Terraform 1.10+). Use dynamodb_table instead on older versions.
