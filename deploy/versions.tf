terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = ">= 2.0"
    }
  }

  # State location is set per environment: terraform init -backend-config=envs/<env>.s3.tfbackend
  backend "s3" {}
}
